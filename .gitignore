/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

# Word temp/lock files
~$*

# Design working screenshots (regenerable, not referenced)
design/_*

# Outreach tracker — holds prospect contact details, and this repo is public.
Fondas_Outreach_Tracker.xlsx

# Holding pen for docs pending deletion — never meant to be tracked.
_to_delete/

# Local Claude Code tool config (per-machine settings, not project source).
.claude/

# Build-gate tarball: the cloud sandbox can't build against macOS node_modules,
# so the working tree is archived here and rebuilt elsewhere. Never committed.
.fonda-src.tar
